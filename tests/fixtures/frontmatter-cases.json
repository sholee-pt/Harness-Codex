      "header": "---\nname: project-harness\ndescription: \"\\\\ud83d\\\\ude00\"\n---\n",
      "expected": {
        "name": "project-harness",
        "description": "\\ud83d\\ude00"
      }
    },
    {
      "id": "quoted-on",
      "header": "---\nname: project-harness\ndescription: \"on\"\n---\n",
      "expected": {
        "name": "project-harness",
        "description": "on"
      }
    },
    {
      "id": "quoted-null",
      "header": "---\nname: project-harness\ndescription: 'null'\n---\n",
      "expected": {
        "name": "project-harness",
        "description": "null"
      }
