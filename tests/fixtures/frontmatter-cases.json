{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "plain",
      "header": "---\nname: project-harness\ndescription: Coordinate fixture work.\n---\n",
      "expected": {
        "name": "project-harness",
        "description": "Coordinate fixture work."
      }
    },
    {
      "id": "quoted-colon",
      "header": "---\nname: project-harness\ndescription: \"Review: validate folds.\"\n---\n",
      "expected": {
        "name": "project-harness",
        "description": "Review: validate folds."
      }
    },
    {
      "id": "quoted-collections",
      "header": "---\nname: project-harness\ndescription: \"[benchmark] {review}\"\n---\n",
      "expected": {
        "name": "project-harness",
        "description": "[benchmark] {review}"
      }
    },
    {
      "id": "single-quote",
      "header": "---\nname: project-harness\ndescription: 'It''s a review.'\n---\n",
      "expected": {
        "name": "project-harness",
        "description": "It's a review."
      }
    },
    {
      "id": "literal-emoji",
      "header": "---\nname: project-harness\ndescription: \"Review \ud83d\ude00 \ud55c\uae00\"\n---\n",
      "expected": {
        "name": "project-harness",
        "description": "Review \ud83d\ude00 \ud55c\uae00"
      }
    },
    {
      "id": "bmp-escape",
      "header": "---\nname: project-harness\ndescription: \"\\u03B1 review\"\n---\n",
      "expected": {
        "name": "project-harness",
        "description": "\u03b1 review"
      }
    },
    {
